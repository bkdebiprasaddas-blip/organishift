PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/organishift

# REQUIRED. Must be >= 16 chars and must NOT be a placeholder when
# NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without it.
JWT_SECRET=replace-with-a-long-random-secret

JWT_EXPIRES_IN=24h
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Local development ONLY. Set to true to let the server fall back to a known
# insecure dev secret when JWT_SECRET is absent. It is ignored outside
# NODE_ENV=development, and it must never be enabled on a deployed host.
# ALLOW_INSECURE_DEV_SECRET=true
